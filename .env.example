# ============================================================
# 银行 AI 智能体 —— 环境变量
# 复制本文件为 .env,填入真实值。.env 已被 .gitignore 忽略。
# ============================================================

# ---------- 大模型(DeepSeek) ----------
# 获取方式:https://platform.deepseek.com/ → API Keys → 创建
# 形如 sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=

# 接口地址(默认即可,除非你走代理或自建网关)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名:deepseek-chat(通用对话/函数调用) | deepseek-reasoner(深度推理,较慢)
DEEPSEEK_MODEL=deepseek-chat

# 采样温度。意图解析需要稳定 → 建议 0 ~ 0.3
DEEPSEEK_TEMPERATURE=0

# 单次请求超时(毫秒)
DEEPSEEK_TIMEOUT_MS=60000

# 关闭真实模型调用,强制走内置确定性 Mock。
# 演示兜底用:断网 / 无 key / 现场翻车时设为 1,整条链路依然跑通。
LLM_OFFLINE=0

# ---------- 服务 ----------
PORT=8787

# ---------- 审计 ----------
# 审计日志输出目录(追加式 JSONL + 哈希链)
AUDIT_DIR=./var/audit
